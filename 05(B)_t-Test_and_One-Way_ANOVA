        "import pandas as pd\n",
        "from scipy import stats\n",
        "from statsmodels.stats.multicomp import pairwise_tukeyhsd\n",
        "\n",
        "# -----------------------------------------\n",
        "# 1. Load dataset\n",
        "# -----------------------------------------\n",
        "\n",
        "df = pd.read_csv(\"medicine_effectiveness_dataset.csv\")\n",
        "\n",
        "print(\"Dataset:\")\n",
        "print(df.head())\n",
        "\n",
        "# -----------------------------------------\n",
        "# 2. One-Sample t-Test\n",
        "# -----------------------------------------\n",
        "\n",
        "medicine_a = df[\n",
        "    df[\"Medicine\"] == \"Medicine_A\"\n",
        "][\"Pain_Reduction\"]\n",
        "\n",
        "benchmark = 6\n",
        "alpha = 0.05\n",
        "\n",
        "t_stat, p_value = stats.ttest_1samp(\n",
        "    medicine_a,\n",
        "    benchmark\n",
        ")\n",
        "\n",
        "print(\"\\n----- ONE-SAMPLE t-TEST -----\")\n",
        "\n",
        "print(\"Medicine A Mean:\",\n",
        "      medicine_a.mean())\n",
        "\n",
        "print(\"Benchmark Mean:\",\n",
        "      benchmark)\n",
        "\n",
        "print(\"t-statistic:\",\n",
        "      t_stat)\n",
        "\n",
        "print(\"p-value:\",\n",
        "      p_value)\n",
        "\n",
        "if p_value < alpha:\n",
        "    print(\"Decision: Reject H0\")\n",
        "    print(\"Conclusion: Medicine A differs significantly from the benchmark.\")\n",
        "else:\n",
        "    print(\"Decision: Fail to Reject H0\")\n",
        "    print(\"Conclusion: There is insufficient evidence that Medicine A differs from the benchmark.\")\n",
        "\n",
        "\n",
        "# -----------------------------------------\n",
        "# 3. One-Way ANOVA\n",
        "# -----------------------------------------\n",
        "\n",
        "medicine_a = df[\n",
        "    df[\"Medicine\"] == \"Medicine_A\"\n",
        "][\"Pain_Reduction\"]\n",
        "\n",
        "medicine_b = df[\n",
        "    df[\"Medicine\"] == \"Medicine_B\"\n",
        "][\"Pain_Reduction\"]\n",
        "\n",
        "medicine_c = df[\n",
        "    df[\"Medicine\"] == \"Medicine_C\"\n",
        "][\"Pain_Reduction\"]\n",
        "\n",
        "f_stat, p_value = stats.f_oneway(\n",
        "    medicine_a,\n",
        "    medicine_b,\n",
        "    medicine_c\n",
        ")\n",
        "\n",
        "print(\"\\n----- ONE-WAY ANOVA -----\")\n",
        "\n",
        "print(\"Medicine A Mean:\",\n",
        "      medicine_a.mean())\n",
        "\n",
        "print(\"Medicine B Mean:\",\n",
        "      medicine_b.mean())\n",
        "\n",
        "print(\"Medicine C Mean:\",\n",
        "      medicine_c.mean())\n",
        "\n",
        "print(\"F-statistic:\",\n",
        "      f_stat)\n",
        "\n",
        "print(\"p-value:\",\n",
        "      p_value)\n",
        "\n",
        "if p_value < alpha:\n",
        "    print(\"Decision: Reject H0\")\n",
        "    print(\"Conclusion: At least one medicine has a different mean effectiveness.\")\n",
        "else:\n",
        "    print(\"Decision: Fail to Reject H0\")\n",
        "    print(\"Conclusion: No statistically significant difference was detected.\")"
      ]
